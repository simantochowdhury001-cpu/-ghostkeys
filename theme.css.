/* GhostKeys colors, fonts, and animation settings */
:root {
  color-scheme: dark;

  --bg: #050505;
  --bg-top: #0a0c0a;
  --panel: #0b120def;
  --accent: #1aff3c;
  --rain-color: #00ff41;
  --ink: #050a06;
  --text: #edf5ef;
  --muted: #a0b3a5;
  --border: #275634;
  --key-bg: #101c14dd;
  --hover: #3b6fd8;
  --danger: #ff6262;

  --font-title: 'Space Grotesk', 'Arial Black', system-ui, sans-serif;
  --font-code: 'JetBrains Mono', 'Fira Code', ui-monospace, monospace;

  --key-height: 48px;
  --radius: 14px;
  --glow: 0 0 18px #1aff3c24;

  --rain-opacity: .24;
  --rain-fps: 60;
  --saver-fps: 18;
  --rain-size: 16;
  --rain-speed: 1;

  --ticker-duration: 32s;
  --saver-ticker-duration: 64s;
  --pulse-duration: 1.8s;
  --cursor-period: 1s;
  --key-pulse-duration: .24s;
  --scanline-opacity: .025;
  --type-delay: 75;
  --type-hold: 1700;
}

body[data-theme="cyber"] {
  --accent: #69b9ff;
  --rain-color: #409dff;
  --border: #2b5278;
  --key-bg: #0d1928dd;
  --panel: #0b111bef;
  --bg-top: #080d17;
  --muted: #a1b6ce;
  --glow: 0 0 18px #69b9ff24;
}

body[data-theme="amber"] {
  --accent: #ffc04d;
  --rain-color: #ffb020;
  --border: #66502a;
  --key-bg: #211b10dd;
  --panel: #15110aef;
  --bg-top: #151007;
  --muted: #c3b394;
  --glow: 0 0 18px #ffc04d24;
}

* {
  box-sizing: border-box;
}

[hidden] {
  display: none !important;
}

html {
  background: var(--bg);
}

body {
  margin: 0;
  min-height: 100dvh;
  overflow: hidden;
  isolation: isolate;
  color: var(--text);
  background: radial-gradient(
    ellipse at top,
    var(--bg-top),
    transparent 75%
  );
  font: 14px/1.5 var(--font-code);
}

#rain {
  position: fixed;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  opacity: var(--rain-opacity);
}

.scanlines {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 5;
  opacity: var(--scanline-opacity);
  background: repeating-linear-gradient(
    transparent 0 3px,
    var(--accent) 3px 4px
  );
}

main {
  width: min(100%, 860px);
  height: calc(100dvh - 76px - env(safe-area-inset-bottom));
  overflow-y: auto;
  margin: auto;
  padding:
    max(18px, env(safe-area-inset-top))
    max(12px, env(safe-area-inset-right))
    max(100px, env(safe-area-inset-bottom))
    max(12px, env(safe-area-inset-left));
}

h1,
h2,
.outline {
  font-family: var(--font-title);
  font-weight: 900;
}

h1 {
  font-size: clamp(48px, 11vw, 88px);
  line-height: 1;
  letter-spacing: -.055em;
  margin: 20px 0 5px;
}

h1 span,
strong,
.stats b {
  color: var(--accent);
}

h2 {
  font-size: 14px;
  letter-spacing: .06em;
  margin: 8px 0;
}

.hero {
  padding: 8px 6px 18px;
}

.eyebrow {
  color: var(--muted);
  font-size: 10px;
  letter-spacing: .12em;
  margin-top: 24px;
}

.outline {
  color: transparent;
  -webkit-text-stroke: 1px var(--accent);
  font-size: clamp(19px, 5.4vw, 36px);
  letter-spacing: -.025em;
  margin: 0 0 18px;
}

.tagline {
  min-height: 3em;
  font-size: 15px;
}

.cursor {
  color: var(--accent);
  font-weight: bold;
  animation: blink var(--cursor-period) steps(1) infinite;
}

.badges,
.section-head {
  display: flex;
  gap: 8px;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
}

.badge {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  font-size: 9px;
  letter-spacing: .08em;
  border: 1px solid var(--border);
  border-radius: 30px;
  padding: 5px 9px;
  color: var(--accent);
  background: var(--key-bg);
}

.badge i {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--accent);
  animation: glow var(--pulse-duration) infinite;
}

.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  margin-top: 10px;
}

.stats div {
  border-left: 1px solid var(--border);
  padding-left: 12px;
}

.stats b {
  display: block;
  font: 800 30px var(--font-title);
}

.stats small {
  font-size: 9px;
  color: var(--muted);
}

.notice {
  border-left: 2px solid var(--accent);
  padding: 10px 12px;
  background: var(--panel);
  font-size: 12px;
}

.panel {
  padding: 14px;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  background: var(--panel);
  box-shadow: var(--glow);
  overflow: hidden;
}

button,
input,
select,
textarea {
  font: inherit;
}

button {
  min-height: 44px;
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 9px 11px;
  color: var(--accent);
  background: var(--key-bg);
  cursor: pointer;
  touch-action: manipulation;
}

button:active,
button[aria-pressed="true"] {
  background: var(--hover);
  color: var(--text);
}

button:disabled {
  opacity: .4;
  cursor: default;
}

@media (hover: hover) {
  button:hover {
    border-color: var(--hover);
  }
}

button:focus-visible,
input:focus-visible,
select:focus-visible,
textarea:focus-visible,
summary:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 3px;
}

button.primary {
  background: var(--accent);
  color: var(--ink);
  font-weight: bold;
  box-shadow: var(--glow);
}

.toolbar {
  display: flex;
  gap: 7px;
  flex-wrap: wrap;
  margin-top: 10px;
}

.toolbar button {
  flex: 1;
}

input,
select,
textarea {
  width: 100%;
  padding: 11px;
  font-size: 16px;
  border: 1px solid var(--border);
  border-radius: 8px;
  background: var(--bg);
  color: var(--text);
}

textarea {
  font-family: var(--font-code);
  resize: vertical;
}

label {
  display: block;
  margin: 14px 0 6px;
  color: var(--muted);
  font-size: 12px;
}

#editor {
  height: 180px;
  min-height: 110px;
  margin-top: 10px;
  line-height: 1.6;
  white-space: pre;
  tab-size: 4;
}

#status {
  min-height: 3em;
  font-size: 12px;
  color: var(--accent);
  margin: 12px 4px;
}

.tabs {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 6px;
  margin: 12px 0;
}

.tabs button[aria-current="page"] {
  background: var(--accent);
  color: var(--ink);
  font-weight: bold;
}

.ticker {
  margin: -14px -14px 12px;
  background: var(--accent);
  color: var(--ink);
  overflow: hidden;
  white-space: nowrap;
  padding: 8px 0;
  font-size: 10px;
  letter-spacing: .15em;
  font-weight: bold;
}

.ticker div {
  display: inline-block;
  animation: ticker var(--ticker-duration) linear infinite;
}

.hint,
footer,
details p {
  font-size: 11px;
  color: var(--muted);
}

.navigation,
.symbols,
.combos,
.letter-row,
.bottom-keys {
  display: grid;
  gap: 4px;
  margin: 8px 0;
}

.navigation {
  grid-template-columns: repeat(8, minmax(0, 1fr));
}

.symbols {
  grid-template-columns: repeat(9, minmax(0, 1fr));
}

.combos {
  grid-template-columns: repeat(3, minmax(0, 1fr));
  padding-bottom: 8px;
  border-bottom: 1px solid var(--border);
}

.letter-row {
  display: flex;
}

.letter-row button {
  flex: 1;
}

.bottom-keys {
  grid-template-columns: 1.2fr 2fr 1fr 1.5fr;
}

.navigation button,
.symbols button,
.letter-row button,
.bottom-keys button,
.combos button {
  padding: 4px 0;
  min-width: 0;
  min-height: var(--key-height);
  font: 14px var(--font-code);
}

.navigation button {
  font-size: 11px;
}

.combos button {
  font-size: 12px;
}

button.pressed {
  animation: keypulse var(--key-pulse-duration) ease-out;
}

.snippet {
  border-top: 1px solid var(--border);
  margin-top: 16px;
  padding-top: 12px;
}

.snippet h3 {
  margin: 0;
  color: var(--text);
  font-size: 14px;
}

.snippet code {
  color: var(--accent);
}

.snippet pre {
  overflow: auto;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  color: var(--muted);
  font-size: 12px;
  max-height: 160px;
  padding: 10px;
  background: var(--bg);
  border-radius: 8px;
}

.snippet .toolbar button {
  font-size: 11px;
  min-width: 42px;
}

.check {
  display: flex;
  align-items: center;
  gap: 10px;
  min-height: 44px;
}

.check input {
  width: 20px;
  height: 20px;
  accent-color: var(--accent);
  flex-shrink: 0;
}

summary {
  cursor: pointer;
  padding: 12px 0;
  color: var(--accent);
}

footer {
  text-align: center;
  margin: 30px 0 0;
  font-size: 9px;
  line-height: 2;
}

.motion-dock {
  position: fixed;
  inset: auto 0 0;
  height: calc(76px + env(safe-area-inset-bottom));
  padding:
    10px
    max(18px, env(safe-area-inset-right))
    calc(10px + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1px solid var(--border);
  background: var(--panel);
  z-index: 6;
  font-size: 10px;
  color: var(--accent);
}

.motion-dock small {
  display: block;
  color: var(--muted);
  font-size: 9px;
}

.motion-button {
  position: relative;
  flex-shrink: 0;
  width: 54px;
  height: 54px;
  border-radius: 50%;
  background: var(--accent);
  color: var(--ink);
  font-weight: bold;
  font-size: 22px;
  box-shadow: var(--glow);
}

.motion-button i {
  position: absolute;
  right: 2px;
  top: 1px;
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: var(--danger);
  border: 2px solid var(--bg);
}

dialog {
  width: min(94%, 540px);
  max-height: 88dvh;
  overflow: auto;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  background: var(--panel);
  color: var(--text);
  padding: 20px;
}

dialog::backdrop {
  background: #000c;
}

dialog textarea {
  min-height: 180px;
}

#formError {
  color: var(--danger);
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip-path: inset(50%);
}

body[data-motion="off"] *,
body[data-motion="off"] *::before {
  animation: none !important;
}

body[data-saver="true"] .badge i {
  animation: none;
}

body[data-saver="true"] .ticker div {
  animation-duration: var(--saver-ticker-duration);
}

@keyframes blink {
  50% {
    opacity: 0;
  }
}

@keyframes glow {
  50% {
    opacity: .35;
  }
}

@keyframes ticker {
  to {
    transform: translateX(-50%);
  }
}

@keyframes keypulse {
  from {
    box-shadow: 0 0 0 0 var(--accent);
  }
  to {
    box-shadow: 0 0 0 8px transparent;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation: none !important;
    scroll-behavior: auto !important;
  }
}
